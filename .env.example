# Local dev: SQLite file. On Vercel, set this to a hosted Postgres URL
# (Vercel Postgres / Neon / Supabase) and change prisma/schema.prisma's
# datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Password for logging into /admin.
ADMIN_PASSWORD="changeme"

# Random secret used to sign the admin session cookie. Generate one with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET="changeme"
